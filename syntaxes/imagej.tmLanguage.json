                                    "name": "punctuation.separator.period.ijm"
                                }
                            ]
                        }
                    }
                },
                {
                    "match": "\\b((?:[A-Za-z_]\\w*\\s*\\.\\s*)*[A-Z_]\\w*)\\b((?=\\s*[A-Za-z$_\\n])|(?=\\s*\\.\\.\\.))",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "match": "[A-Za-z_]\\w*",
                                    "name": "storage.type.ijm"
                                },
                                {
                                    "match": "\\.",
                                    "name": "punctuation.separator.period.ijm"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        "object-types-inherited": {
            "patterns": [
                {
                    "match": "\\b(?:[A-Z]\\w*\\s*(\\.)\\s*)*[A-Z]\\w*\\b",
                    "name": "entity.other.inherited-class.ijm",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.period.ijm"
                        }
                    }
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.delimiter.ijm"
                }
            ]
        },
        "objects": {
            "match": "(?<![\\w$])[a-zA-Z_$][\\w$]*(?=\\s*\\.\\s*[\\w$]+)",
            "name": "variable.other.object.ijm"
        },
        "parameters": {
            "patterns": [
                {
                    "match": "\\bfinal\\b",
                    "name": "storage.modifier.ijm"
                },
                {
                    "include": "#annotations"
                },
                {
                    "include": "#all-types"
                },
                {
                    "include": "#strings"
                },
                {
                    "match": "\\w+",
                    "name": "variable.parameter.ijm"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.delimiter.ijm"
                },
                {
                    "match": "\\.\\.\\.",
                    "name": "punctuation.definition.parameters.varargs.ijm"
                }
            ]
        },
        "parens": {
            "patterns": [
                {
                    "begin": "\\(",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.bracket.round.ijm"
                        }
                    },
                    "end": "\\)",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.bracket.round.ijm"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#code"
                        }
                    ]
                },
                {
                    "begin": "\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.bracket.square.ijm"
                        }
                    },
                    "end": "\\]",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.bracket.square.ijm"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#code"
                        }
                    ]
                },
                {
                    "begin": "{",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.bracket.curly.ijm"
                        }
                    },
                    "end": "}",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.bracket.curly.ijm"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#code"
                        }
                    ]
                }
            ]
        },
        "primitive-arrays": {
            "patterns": [
                {
                    "begin": "\\b(void|boolean|byte|char|short|int|float|long|double)\\b\\s*(?=\\[)",
                    "beginCaptures": {
                        "1": {
                            "name": "storage.type.primitive.array.ijm"
                        }
                    },
                    "end": "(?!\\s*\\[)",
                    "patterns": [
                        {
                            "include": "#comments"
                        },
                        {
                            "include": "#parens"
                        }
                    ]
                }
            ]
        },
        "primitive-types": {
            "match": "\\b(var)\\b",
            "name": "storage.type.var.ijm"
        },
        "properties": {
            "patterns": [
                {
                    "match": "(\\.)\\s*(new)",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.period.ijm"
                        },
                        "2": {
                            "name": "keyword.control.new.ijm"
                        }
                    }
                },
                {
                    "match": "(\\.)\\s*([a-zA-Z_$][\\w$]*)(?=\\s*\\.\\s*[a-zA-Z_$][\\w$]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.period.ijm"
                        },
                        "2": {
                            "name": "variable.other.object.property.ijm"
                        }
                    }
                },
                {
                    "match": "(\\.)\\s*([a-zA-Z_$][\\w$]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.period.ijm"
                        },
                        "2": {
                            "name": "variable.other.object.property.ijm"
                        }
                    }
                },
                {
                    "match": "(\\.)\\s*([0-9][\\w$]*)",
                    "captures": {
                        "1": {
                            "name": "punctuation.separator.period.ijm"
                        },
                        "2": {
                            "name": "invalid.illegal.identifier.ijm"
                        }
                    }
                }
            ]
        },
        "static-initializer": {
            "patterns": [
                {
                    "include": "#anonymous-block-and-instance-initializer"
                },
                {
                    "match": "static",
                    "name": "storage.modifier.ijm"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "begin": "\"\"\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.ijm"
                        }
                    },
                    "end": "\"\"\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.ijm"
                        }
                    },
                    "name": "string.quoted.triple.ijm",
                    "patterns": [
                        {
                            "match": "(\\\\\"\"\")(?!\")|(\\\\.)",
                            "name": "constant.character.escape.ijm"
                        }
                    ]
                },
                {
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.ijm"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.ijm"
                        }
                    },
                    "name": "string.quoted.double.ijm",
                    "patterns": [
                        {
                            "match": "\\\\.",
                            "name": "constant.character.escape.ijm"
                        }
                    ]
                },
                {
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.ijm"
                        }
                    },
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.ijm"
                        }
                    },
                    "name": "string.quoted.single.ijm",
                    "patterns": [
                        {
                            "match": "\\\\.",
                            "name": "constant.character.escape.ijm"
                        }
                    ]
                }
            ]
        },
        "variables": {
            "begin": "(?=\\b(var)\\b\\s+[A-Za-z_$][\\w$]*\\s*(=|:|;))",
            "end": "(?=\\=|:|;)",
            "name": "meta.definition.variable.ijm",
            "patterns": [
                {
                    "match": "\\bvar\\b",
                    "name": "storage.type.ijm"
                },
                {
                    "match": "([A-Za-z$_][\\w$]*)(?=\\s*(\\[\\])*\\s*(=|:|;))",
                    "captures": {
                        "1": {
                            "name": "variable.other.definition.ijm"
                        }
                    }
                },
                {
                    "include": "#code"
                }
            ]
        }
    }
}
